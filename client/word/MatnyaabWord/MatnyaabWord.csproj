<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>MatnyaabWord</AssemblyName>
    <RootNamespace>Matnyaab.Word</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Matnyaab for Word</Product>
    <Company>Matnyaab</Company>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
    <None Update="Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Ribbon.xml" LogicalName="Matnyaab.Word.Ribbon.xml" />
    <EmbeddedResource Include="Resources\templates.json" LogicalName="Matnyaab.Word.templates.json" />
  </ItemGroup>
</Project>
