DirectoryIndex index.php index.html

RewriteEngine On
RewriteRule ^health/?$ recovery.php?_route=health [QSA,L]
RewriteRule ^news/?$ recovery.php?_route=news [QSA,L]
RewriteRule ^get_contents/?$ recovery.php?_route=get_contents [QSA,L]
RewriteRule ^statistics/?$ recovery.php?_route=statistics [QSA,L]
RewriteRule ^download_content/?$ recovery.php?_route=download_content [QSA,L]
RewriteRule ^download_content_img/?$ recovery.php?_route=download_content_img [QSA,L]

<FilesMatch "(^\.env$|\.sqlite3?$|\.db$|\.bak$|^private\.py$)">
    Require all denied
</FilesMatch>
